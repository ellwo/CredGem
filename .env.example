# ============================================
# CredGem Production Environment Variables
# ============================================
# Copy this file to .env and update with your values
# cp .env.example .env

# ============================================
# Nginx Configuration
# ============================================
# HTTP port for nginx (default: 80)
NGINX_PORT=80

# HTTPS port for nginx (default: 443)
# Uncomment when you have SSL certificates configured
# NGINX_HTTPS_PORT=443

# ============================================
# PostgreSQL Database Configuration
# ============================================
# PostgreSQL username (default: postgres)
POSTGRES_USER=postgres

# PostgreSQL password (CHANGE THIS IN PRODUCTION!)
POSTGRES_PASSWORD=postgres

# PostgreSQL database name (default: credgem)
POSTGRES_DB=credgem

# PostgreSQL port (default: 5432)
# Note: Not exposed externally in production, only for internal reference
POSTGRES_PORT=5432

# ============================================
# Redis Configuration
# ============================================
# Redis port (default: 6379)
# Note: Not exposed externally in production, only for internal reference
REDIS_PORT=6379

# Redis password (optional, leave empty for no password)
# If set, Redis will require authentication
REDIS_PASSWORD=

# Full Redis URL (optional, will be auto-generated if not set)
# Format: redis://[:password@]host:port
# Example with password: redis://:your_password@redis-container-credgem:6379
# Example without password: redis://redis-container-credgem:6379
# REDIS_URL=redis://redis-container-credgem:6379

# ============================================
# Server Configuration
# ============================================
# Server port (default: 8000)
# Note: Not exposed externally in production, accessed via nginx
SERVER_PORT=8000

# Server environment (dev, prod, test)
# Set to 'prod' for production
ENV=prod

# CORS allowed origins (comma-separated, or * for all)
# For production, specify your domain(s):
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# For development, you can use:
CORS_ALLOWED_ORIGINS=*

# ============================================
# Admin Panel Configuration
# ============================================
# Admin panel port (default: 3000)
# Note: Not exposed externally in production, accessed via nginx
ADMIN_PANEL_PORT=3000

# API URL for admin panel (used during build)
# Should be relative path when using nginx: /api/v1
# Or full URL for development: http://localhost:8000/api/v1
VITE_API_URL=/api/v1

# ============================================
# Security Notes
# ============================================
# IMPORTANT: In production, you MUST:
# 1. Change POSTGRES_PASSWORD to a strong password
# 2. Set REDIS_PASSWORD if using Redis authentication
# 3. Set CORS_ALLOWED_ORIGINS to your actual domain(s)
# 4. Configure SSL/TLS certificates for HTTPS
# 5. Keep this .env file secure and never commit it to version control

